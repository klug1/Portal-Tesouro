        <css>.widget-container, .widget-container h4, .widget-container p, .widget-container a {&#13;
  color: white;&#13;
}&#13;
&#13;
h6 {&#13;
  color: #CBCBCB;&#13;
}&#13;
&#13;
.widget-container {&#13;
  display: flex;&#13;
  flex-wrap: wrap;&#13;
  justify-content: space-between;&#13;
  align-items: flex-start;&#13;
  background-color: #293273;&#13;
  padding: 5px 10px;&#13;
  color: white;&#13;
  height: 153px; /* Ajustar conforme necessário para acomodar todo o conteúdo */&#13;
}&#13;
&#13;
.left, .center, .right {&#13;
  flex: 1;&#13;
  min-width: 200px;&#13;
  margin-bottom: 5px;&#13;
}&#13;
&#13;
.left {&#13;
  text-align: left;&#13;
}&#13;
&#13;
.center {&#13;
  text-align: center;&#13;
  display: flex;&#13;
  flex-direction: column;&#13;
  justify-content: center;&#13;
  padding-top: 1.5em; /* Adiciona espaço no topo dos elementos dentro de .center */&#13;
}&#13;
&#13;
.center h4 {&#13;
  margin: 5px 0; /* Ajusta o espaçamento superior e inferior entre os h4 */&#13;
  line-height: 1; /* Ajuste do espaçamento entre as linhas */&#13;
}&#13;
&#13;
.right {&#13;
  display: flex; &#13;
  flex-direction: column;&#13;
  align-items: flex-end; /* Alinha a seção .right à direita do container */&#13;
  text-align: center; /* Alinha o texto do bloco à direita, mas... */&#13;
}&#13;
&#13;
.right p, .right a {&#13;
  margin: 0;&#13;
  text-align: right; /* ...garante que o texto dentro dos &lt;p&gt; e &lt;a&gt; esteja à esquerda */&#13;
}&#13;
&#13;
h4 {&#13;
  color: #F9F9F9;&#13;
  text-align: center;&#13;
  font-family: Roboto;&#13;
  font-size: 18px;&#13;
  font-style: normal;&#13;
  font-weight: 400;&#13;
  line-height: normal;&#13;
}&#13;
&#13;
h6 {&#13;
  color: #CBCBCB;&#13;
  text-align: center;&#13;
  font-family: Roboto;&#13;
  font-size: 12px;&#13;
  font-style: normal;&#13;
  font-weight: 100;&#13;
  line-height: normal;&#13;
}&#13;
&#13;
p {&#13;
  margin: 5px 0;&#13;
}&#13;
&#13;
@media screen and (max-width: 768px) {&#13;
  .widget-container {&#13;
    flex-direction: column;&#13;
    align-items: center;&#13;
    height: auto; /*Permite que a altura se ajuste ao conteúdo */&#13;
  }&#13;
&#13;
  .left, .center, .right {&#13;
    text-align: center;&#13;
    align-items: center;&#13;
  }&#13;
&#13;
  .right {&#13;
    align-items: center;&#13;
    text-align: center;&#13;
  }&#13;
}</css>
