        <name>WIdget receita corrente x despesa liqui</name>
        <option_schema/>
        <public>true</public>
        <roles/>
        <script><![CDATA[(function() {
    var dados = [];
    var gr = new GlideRecord('x_sded9_portal_t_0_u_despesa_pessoal');
    gr.orderBy('u_ano');
    gr.query();

    while (gr.next()) {
        dados.push({
            ano: gr.getValue('u_ano'),
            receitasLiquida: parseFloat(gr.getValue('u_receita_corrente_liquida')) || 10202,
            despesaLiquida: parseFloat(gr.getValue('u_despesa_liquida_pedidos'))
        });
    }

    data.series = dados;
})();
]]></script>
