        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return;
    }
    
    // Pega a linha atual do multirow
    var row = g_form.getGlideUIElement().getParentRow();
    
    // Obtém os valores dos campos
    var mes = row.getElementsByClassName("v_mes")[0].value;
    var ano = row.getElementsByClassName("v_ano")[0].value;
    
    // Verifica se ambos campos estão preenchidos
    if (mes && ano) {
        // Atualiza o campo de combinação
        row.getElementsByClassName("v_combinacao")[0].value = mes + '/' + ano;
        
        // Atualiza a interface (opcional, dependendo do comportamento desejado)
        g_form.save();
    }
}]]></script>
