        <name>Widget receita corrente liquida x pessoa</name>
        <option_schema/>
        <public>true</public>
        <roles/>
        <script><![CDATA[(function() {
    var gr = new GlideRecord('x_sded9_portal_t_0_u_despesa_pessoal');
    gr.orderBy('u_ano');
    gr.query();

    data.chartBarData = [];

    while (gr.next()) {
        data.chartBarData.push({
            ano: gr.getValue('u_ano'),
            despesa_liquida: parseFloat(gr.getValue('u_despesa_liquida_pedidos')),
            receita_corrente: parseFloat(gr.getValue('u_receita_corrente_liquida'))
        });
    }
})();
]]></script>
