  <script>
(function() {
  var slider = document.querySelector('.banner-sefaz-container .slider');
  var prevBtn = document.querySelector('.banner-sefaz-container .prev');
  var nextBtn = document.querySelector('.banner-sefaz-container .next');
  var autoRotateTimeout;

  function rotateNext() {
    var items = document.querySelectorAll('.banner-sefaz-container .item');
    slider.appendChild(items[0]);
  }

  function autoRotate() {
    autoRotateTimeout = setTimeout(function() {
      rotateNext();
      autoRotate();
    }, 5000);
  }

  function resetAutoRotate() {
    clearTimeout(autoRotateTimeout);
    autoRotate();
  }

  if (prevBtn) {
    prevBtn.onclick = function(e) {
      var items = document.querySelectorAll('.banner-sefaz-container .item');
      slider.insertBefore(items[items.length - 1], slider.firstChild);
      resetAutoRotate();
    };
  }

  if (nextBtn) {
    nextBtn.onclick = function(e) {
      rotateNext();
      resetAutoRotate();
    };
  }

  // Swipe em dispositivos móveis
  var touchStartX = 0;
  var touchEndX = 0;

  slider.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
  }, false);

  slider.addEventListener('touchend', function(e) {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }, false);

  function handleSwipe() {
    if (touchEndX < touchStartX) {
      nextBtn.onclick();
    } else if (touchEndX > touchStartX) {
      prevBtn.onclick();
    }
  }

  // Inicia rotação automática ao carregar a página
  autoRotate();
})();


  </script>
