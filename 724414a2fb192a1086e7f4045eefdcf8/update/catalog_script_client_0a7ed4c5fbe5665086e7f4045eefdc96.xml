        <script><![CDATA[function onSubmit() {
    cleanCurrency('v_estoque_total_da_divida_publica_soma_interna_externa');
    cleanCurrency('v_estoque_da_divida_publica_externa');
    cleanCurrency('v_estoque_da_divida_publica_interna');
    return true;
}

function cleanCurrency(variableName) {
    let value = g_form.getValue(variableName);
    if (!value) return;

    value = value.replace(/[R$\s\.]/g, '').replace(',', '.');

    g_form.setValue(variableName, value);

}
]]></script>
