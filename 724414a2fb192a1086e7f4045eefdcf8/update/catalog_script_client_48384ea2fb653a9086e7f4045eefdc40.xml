        <name>Unmasking Percent fields</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onSubmit() {
    cleanPercent('v_meta');
    cleanPercent('v_realizado');
    return true;
}

function cleanPercent(variableName) {
    var value = g_form.getValue(variableName);
    if (!value) return;

    value = value.replace('%', '').replace(',', '.').replace(/\./g, '').trim();

    if (!isNaN(value)) {
        var numericValue = parseFloat(value) / 100;
        g_form.setValue(variableName, numericValue.toString());
    } else {
        g_form.setValue(variableName, value);
    }
}]]></script>
