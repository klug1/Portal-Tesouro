        <name>Unmasking Monetary Fields</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    cleanCurrency('u_rreo_lrf');
    cleanCurrency('u_rreo_ajustada');
    return true;
}

function cleanCurrency(variableName) {
    let value = g_form.getValue(variableName);
    if (!value) return;
    value = value.replace(/[R$\s\.]/g, '').replace(',', '.');
    g_form.setValue(variableName, value);
}]]></script>
