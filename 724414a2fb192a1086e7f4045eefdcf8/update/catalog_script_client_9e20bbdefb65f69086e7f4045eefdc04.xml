        <script><![CDATA[function onSubmit() {
    cleanCurrency('v_valor_apurado_resultado_primario');
    cleanCurrency('v_meta_resultado_primario');
    cleanCurrency('v_meta_arrecadacao_propria');
    cleanCurrency('v_valor_apurado_arrecadacao_propria');
    cleanCurrency('v_valor_apurado_caixa_liquido');
    cleanCurrency('v_meta_caixa_liquido');
    return true;
}

function cleanCurrency(variableName) {
    var value = g_form.getValue(variableName);
    if (!value) return;
    value = value.replace(/[R$\s\.]/g, '').replace(',', '.');
    g_form.setValue(variableName, value);
}]]></script>
