})($sp, input, data, options);]]&gt;&lt;/script&gt;&lt;servicenow&gt;false&lt;/servicenow&gt;&lt;sys_class_name&gt;sp_widget&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2022-10-04 16:44:31&lt;/sys_created_on&gt;&lt;sys_id&gt;d1b001d677525110230afd708e5a9979&lt;/sys_id&gt;&lt;sys_mod_count&gt;12&lt;/sys_mod_count&gt;&lt;sys_name&gt;Captcha for RP&lt;/sys_name&gt;&lt;sys_package display_value="Public Sector Digital Services Core" source="sn_gsm"&gt;1973cb4153333010e897ddeeff7b129f&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Public Sector Digital Services Core"&gt;1973cb4153333010e897ddeeff7b129f&lt;/sys_scope&gt;&lt;sys_update_name&gt;sp_widget_d1b001d677525110230afd708e5a9979&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2022-10-11 17:41:14&lt;/sys_updated_on&gt;&lt;template&gt;&lt;![CDATA[&lt;div id="reg-form" class="col-lg-12 col-md-12 col-sm-12 col-xs-12 wrapper panel" style="margin:20px;" ng-init="registrationInit()"&gt;
